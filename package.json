{
  "name": "game-client-knowledge-web",
  "version": "1.0.0",
  "private": true,
  "description": "Convention-driven static website for Game Client Knowledge.",
  "scripts": {
    "build:vendor": "node scripts/build-editor-vendor.js",
    "build:mermaid": "node scripts/build-mermaid-cache.js",
    "build": "npm run build:vendor && npm run build:mermaid && node scripts/clean.js && eleventy",
    "dev": "eleventy --serve --quiet",
    "audit": "node scripts/audit-content.js",
    "audit:site": "node scripts/audit-site.js",
    "test:markdown-structure": "node scripts/test-markdown-structure.js",
    "test:markdown-preserve": "node scripts/test-markdown-preserve.js",
    "test:source-cache": "node scripts/test-source-cache.js",
    "test:editor-buffer": "node scripts/test-editor-buffer.js",
    "test:editor-document": "node scripts/test-editor-document.js",
    "test:workspace-tree": "node scripts/test-workspace-tree.js",
    "test:workspace-store": "node scripts/test-workspace-store.js",
    "test:editor-workspace": "node scripts/test-editor-workspace.js",
    "test:site-update": "node scripts/test-site-update-control.js && bash scripts/test-site-update-failure.sh",
    "test:line-attribution": "python3 scripts/test-sync-line-authors.py",
    "test:site-analytics": "node scripts/test-site-analytics.js",
    "test:home-intro-policy": "node scripts/test-home-intro-policy.js",
    "test:home-star-graph": "node scripts/test-home-star-graph.js",
    "test:home-star-illumination": "node scripts/test-home-star-illumination.js",
    "test:home-star-3d": "node scripts/test-home-star-3d.js",
    "test:home-star-3d-visual": "node scripts/test-home-star-3d-visual.js",
    "test:star-formula": "node scripts/test-star-formula-engine.js",
    "test:home-content-controls": "node scripts/test-home-content-controls.js",
    "test:onboarding-guide": "node scripts/test-onboarding-guide.js",
    "test:admin-layout": "node scripts/test-admin-layout.js",
    "test:home-content-visual": "node scripts/test-home-content-visual.js",
    "test:content-loader": "node scripts/test-content-loader.js",
    "test:content-statistics": "node scripts/test-content-statistics.js",
    "test:code-projects": "node scripts/test-code-project-loader.js",
    "test:code-intelligence": "node scripts/test-code-intelligence.js",
    "test:reader-comments": "node scripts/test-reader-comments.js",
    "test:reader-diff": "node scripts/test-reader-diff.js",
    "test:visual": "node scripts/visual-check.js",
    "deploy:join": "bash scripts/deploy-join.sh",
    "deploy:editor": "bash scripts/deploy-editor.sh",
    "deploy:update-control": "bash scripts/install-update-control.sh",
    "deploy:server": "bash scripts/deploy-server.sh",
    "check": "npm run test:markdown-structure && npm run test:markdown-preserve && npm run test:source-cache && npm run test:editor-buffer && npm run test:editor-document && npm run test:workspace-tree && npm run test:workspace-store && npm run test:editor-workspace && npm run test:site-update && npm run test:line-attribution && npm run test:home-intro-policy && npm run test:home-star-graph && npm run test:home-star-illumination && npm run test:home-star-3d && npm run test:star-formula && npm run test:home-content-controls && npm run test:onboarding-guide && npm run test:admin-layout && npm run test:content-loader && npm run test:content-statistics && npm run test:code-projects && npm run test:code-intelligence && npm run test:reader-comments && npm run test:reader-diff && npm run audit && npm run build && npm run audit:site"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "@toast-ui/editor": "3.2.2",
    "diff": "8.0.4",
    "esbuild": "0.28.2",
    "gray-matter": "4.0.3",
    "jsep": "1.4.0",
    "lucide": "0.468.0",
    "markdown-it": "15.0.0",
    "markdown-it-anchor": "9.2.1",
    "mermaid": "11.16.1",
    "playwright-core": "1.62.1",
    "prismjs": "1.30.0",
    "three": "0.185.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "overrides": {
    "dompurify": "3.4.13",
    "@11ty/eleventy": {
      "markdown-it": "15.0.0"
    }
  }
}
