---
layout: layouts/base.njk
pagination:
  data: catalog.modules
  size: 1
  alias: module
permalink: "{{ module.outputPath }}"
eleventyComputed:
  title: "{{ module.title }}"
  description: "{{ module.description }}"
  activeModule: "{{ module.key }}"
  pageKind: "module"
---

<div
  class="module-page-shell"
  data-editor-host
  data-editor-source="{{ module.sourceRelative }}"
>
  <header class="module-page-header module-{{ module.accent }}">
    <nav class="breadcrumbs" aria-label="面包屑">
      <a href="{{ '/' | withBase }}">首页</a>
      <i data-lucide="chevron-right" aria-hidden="true"></i>
      <span>{{ module.title }}</span>
    </nav>
    <div class="module-title-row">
      <span class="module-icon">
        <i data-lucide="{{ module.icon }}" aria-hidden="true"></i>
      </span>
      <div>
        <p class="eyebrow">
          {% if module.key == "code" %}
            {{ catalog.codeProjects | length }} 个代码工程
          {% else %}
            {{ module.documentCount }} 篇内容{% if module.codeCount %} · {{ module.codeCount }} 个源码文件{% endif %}
          {% endif %}
        </p>
        <h1>{{ module.title }}</h1>
        <p>{{ module.description }}</p>
      </div>
    </div>
    <div class="module-editor-actions edit-mode-only" data-edit-mode-only>
      <button class="secondary-button" type="button" data-edit-current>
        <i data-lucide="square-pen" aria-hidden="true"></i>
        编辑模块说明
      </button>
      <button
        class="secondary-button"
        type="button"
        data-create-context="module"
        data-create-root="{{ module.key }}"
        data-create-parent="{{ module.key }}"
        data-create-use-current
      >
        <i data-lucide="folder-plus" aria-hidden="true"></i>
        新建子模块
      </button>
      <button
        class="secondary-button"
        type="button"
        data-create-context="file"
        data-create-root="{{ module.key }}"
        data-create-parent="{{ module.key }}"
        data-create-use-current
      >
        <i data-lucide="file-plus-2" aria-hidden="true"></i>
        新建文件
      </button>
      <a
        class="secondary-button"
        href="{{ site.editorUrl }}?new_module=1"
      >
        <i data-lucide="layout-grid" aria-hidden="true"></i>
        新增大模块
      </a>
    </div>
  </header>

  <div data-editable-rendered>
    {% if module.body %}
      <div class="module-introduction prose compact-prose">
        {{ module.body | renderMarkdown(module.sourceRelative) | safe }}
      </div>
    {% endif %}
  </div>

  {% if module.key == "code" %}
    <section class="code-project-directory" aria-labelledby="code-project-title">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Client-side code intelligence</p>
          <h2 id="code-project-title">代码工程</h2>
        </div>
        <span>浏览器内搜索与符号解析</span>
      </div>
      <div class="code-project-grid">
        {% for project in catalog.codeProjects %}
          <article class="code-project-card">
            <header>
              <span class="code-project-language">{{ project.language }}</span>
              <span>{{ project.fileCount }} files · {{ project.lineCount }} lines</span>
            </header>
            <h3>{{ project.title }}</h3>
            <p>{{ project.description }}</p>
            <dl>
              <div><dt>入口</dt><dd>{{ project.entry }}</dd></div>
              <div><dt>解析器</dt><dd>{{ project.parsers | join(", ") }}</dd></div>
            </dl>
            <a class="primary-button" href="{{ project.workspaceRoute | withBase }}">
              <i data-lucide="panels-top-left" aria-hidden="true"></i>
              打开代码工作区
            </a>
          </article>
        {% else %}
          <p class="empty-state">暂无符合规范的代码工程。</p>
        {% endfor %}
      </div>
    </section>
  {% else %}
  <section class="module-directory" aria-labelledby="{{ module.key }}-directory">
    <div class="section-heading">
      <div>
        <p class="eyebrow">按目录自动生成</p>
        <h2 id="{{ module.key }}-directory">全部专题</h2>
      </div>
      <button
        class="filter-search"
        type="button"
        data-open-search
        data-search-module="{{ module.key }}"
      >
        <i data-lucide="search" aria-hidden="true"></i>
        在本模块中搜索
      </button>
    </div>

    <div class="module-unit-list">
      {% for unit in module.units %}
        <article class="module-unit">
          <div class="module-unit-summary">
            <p class="unit-meta">
              {% if unit.group %}{{ unit.group }} · {% endif %}
              {{ unit.articleCount }} 篇
              {% if unit.codeCount %} · {{ unit.codeCount }} 个源码文件{% endif %}
            </p>
            <h3><a href="{{ unit.route | withBase }}">{{ unit.title }}</a></h3>
            <p>{{ unit.description }}</p>
            <div class="unit-editor-actions edit-mode-only" data-edit-mode-only>
              <button
                type="button"
                data-create-context="module"
                data-create-root="{{ module.key }}"
                data-create-parent="{{ unit.id }}"
                aria-label="在 {{ unit.title }} 下新建子模块"
                title="新建子模块"
              >
                <i data-lucide="folder-plus" aria-hidden="true"></i>
                子模块
              </button>
              <button
                type="button"
                data-create-context="file"
                data-create-root="{{ module.key }}"
                data-create-parent="{{ unit.id }}"
                aria-label="在 {{ unit.title }} 下新建文件"
                title="新建文件"
              >
                <i data-lucide="file-plus-2" aria-hidden="true"></i>
                文件
              </button>
            </div>
          </div>
          <ol class="module-unit-documents">
            {% for item in unit.documents %}
              <li>
                <a href="{{ item.route | withBase }}">
                  <i
                    data-lucide="{% if item.kind == 'code' %}file-code-2{% else %}file-text{% endif %}"
                    aria-hidden="true"
                  ></i>
                  <span>{{ item.title }}</span>
                  <i data-lucide="chevron-right" aria-hidden="true"></i>
                </a>
              </li>
            {% endfor %}
          </ol>
        </article>
      {% else %}
        <p class="empty-state">该模块暂无内容。</p>
      {% endfor %}
    </div>
  </section>
  {% endif %}
</div>
