---
layout: layouts/base.njk
pageKind: home
permalink: index.html
---

{% set overallStats = catalog.contentStatistics.scopes[0] %}

<section class="library-intro">
  <canvas class="knowledge-field" data-knowledge-field aria-hidden="true"></canvas>
  <div class="library-intro-overlay">
    <div class="library-intro-heading-row">
      <div class="library-intro-copy">
        <p class="eyebrow">开放 · 持续更新 · 多人共建</p>
        <h1>Game Client Knowledge</h1>
        <p class="intro-copy">
          游戏客户端开发与面试知识库。按专题学习，按公司复盘面经，
          直接阅读配套源码。
        </p>
        <div class="intro-actions">
          <button class="intro-search" type="button" data-open-search>
            <i data-lucide="search" aria-hidden="true"></i>
            搜索全部内容
            <span>⌘ K</span>
          </button>
          <a class="intro-catalog-link" href="#catalog-title">
            浏览知识体系
            <i data-lucide="arrow-down" aria-hidden="true"></i>
          </a>
        </div>
      </div>
      <section
        class="contribution-space-section"
        aria-labelledby="contribution-space-title"
        data-contribution-space-section
      >
        <div class="contribution-space-section-inner">
          <header class="contribution-space-heading">
            <p class="eyebrow">Contribution space</p>
            <h2 id="contribution-space-title">贡献</h2>
          </header>
          <button
            class="contribution-space-portal"
            type="button"
            data-contribution-space-portal
            aria-label="进入贡献空间"
            title="拖动旋转，点击进入"
          >
            <span class="contribution-space-portal-label">
              <small>Contribution</small>
              <strong>贡献</strong>
            </span>
            <i data-lucide="arrow-up-right" aria-hidden="true"></i>
          </button>
        </div>
      </section>
    </div>
    <dl class="intro-stats" aria-label="知识库内容统计">
      <div>
        <dt>最新内容更新</dt>
        <dd class="is-date">
          <time datetime="{{ overallStats.latestUpdatedAt }}">
            {{ overallStats.latestUpdatedAt | formatDateTime }}
          </time>
        </dd>
      </div>
      <div>
        <dt>当前总字数</dt>
        <dd>{{ overallStats.characterCount | formatNumber }}</dd>
      </div>
      <div>
        <dt>当前总行数</dt>
        <dd>{{ overallStats.lineCount | formatNumber }}</dd>
      </div>
      <div>
        <dt>贡献者</dt>
        <dd data-contribution-count="all">
          {{ overallStats.contributorCount | formatNumber }}
        </dd>
      </div>
    </dl>
  </div>
</section>

<button
  class="contribution-space-return"
  type="button"
  data-contribution-space-return
  aria-label="返回主页面"
>
  <i data-lucide="arrow-left" aria-hidden="true"></i>
  <span>返回主页面</span>
</button>

<label
  class="contribution-space-structure-control"
  data-contribution-space-structure-control
>
  <i data-lucide="orbit" aria-hidden="true"></i>
  <span class="contribution-space-structure-label">星系布局</span>
  <span class="contribution-space-structure-select">
    <select
      data-contribution-space-structure
      aria-label="选择星系布局"
    >
      <option value="3d">3D 立体</option>
      <option value="3d-drift">随机漂移</option>
      <option value="3d-drift-anchored">静星锚定</option>
      <option value="3d-galaxy">银河系</option>
      <option value="3d-orbit">轨道星系</option>
      <option value="3d-spiral">螺旋星系</option>
      <option value="3d-nebula">星云带</option>
      <option value="3d-clusters">星团</option>
      <option value="3d-shell">分层星壳</option>
    </select>
    <i data-lucide="chevron-down" aria-hidden="true"></i>
  </span>
</label>

<section class="contribution-ledger" aria-labelledby="contribution-ledger-title">
  <div class="contribution-ledger-inner">
    <header class="contribution-ledger-heading">
      <div>
        <p class="eyebrow">Contribution ledger</p>
        <h2 id="contribution-ledger-title">内容贡献统计</h2>
      </div>
      <div class="contribution-ledger-controls">
        <div class="segmented-control" role="group" aria-label="贡献赛道">
          {% for scope in catalog.contentStatistics.scopes %}
            <button
              type="button"
              data-contribution-scope="{{ scope.key }}"
              aria-pressed="{{ 'true' if loop.first else 'false' }}"
            >
              {{ scope.title }}
            </button>
          {% endfor %}
        </div>
        <div class="segmented-control" role="group" aria-label="统计周期">
          <button type="button" data-contribution-period="all" aria-pressed="true">
            累计
          </button>
          <button type="button" data-contribution-period="week" aria-pressed="false">
            最近 7 天
          </button>
        </div>
      </div>
    </header>

    <div class="contribution-scope-summary">
      <strong data-contribution-scope-title>{{ overallStats.title }}</strong>
      <span data-contribution-scope-summary>
        <span data-contribution-count="all">
          {{ overallStats.contributorCount }}
        </span>
        位贡献者 ·
        {{ overallStats.fileCount | formatNumber }} 个文本资源
      </span>
    </div>

    <div class="contribution-list-controls">
      <label>
        <span>每页</span>
        <select
          data-contribution-page-size
          aria-label="每页贡献者人数"
        >
          <option value="3" selected>3 人</option>
          <option value="5">5 人</option>
          <option value="10">10 人</option>
          <option value="20">20 人</option>
        </select>
      </label>
      <label>
        <span>人数</span>
        <select
          data-contribution-total-limit
          aria-label="最多显示贡献者人数"
        >
          <option value="5">前 5 人</option>
          <option value="10" selected>前 10 人</option>
          <option value="25">前 25 人</option>
          <option value="all">全部</option>
        </select>
      </label>
      <label class="contribution-sort-control">
        <span>排序</span>
        <select data-contribution-sort aria-label="贡献者排序字段">
          <option value="total" selected>变更合计</option>
          <option value="added">新增行</option>
          <option value="modified">更改行</option>
          <option value="deleted">删除行</option>
          <option value="recent">最近贡献</option>
          <option value="name">名称</option>
        </select>
      </label>
      <button
        class="icon-button contribution-sort-direction"
        type="button"
        data-contribution-sort-direction
        aria-label="当前降序，切换为升序"
        title="降序"
      >
        <i data-lucide="arrow-down-wide-narrow" aria-hidden="true"></i>
      </button>
    </div>

    <div class="contribution-table-wrap" tabindex="0">
      <table class="contribution-table">
        <thead>
          <tr>
            <th scope="col" data-contribution-sort-column="name">贡献者</th>
            <th scope="col" data-contribution-sort-column="added">新增</th>
            <th scope="col" data-contribution-sort-column="modified">
              <abbr title="同一文件中成对出现的新增与删除行">更改</abbr>
            </th>
            <th scope="col" data-contribution-sort-column="deleted">删除</th>
            <th scope="col" data-contribution-sort-column="total">
              变更合计
            </th>
          </tr>
        </thead>
        <tbody data-contribution-rows>
          {% for contributor in overallStats.contributors %}
            <tr>
              <th scope="row">
                <span class="contributor-avatar" aria-hidden="true">
                  {{ contributor.name | first | upper }}
                </span>
                <span>{{ contributor.name }}</span>
              </th>
              <td class="line-added">
                {% if contributor.added %}+{{ contributor.added | formatNumber }}{% else %}0{% endif %}
              </td>
              <td class="line-modified">
                {% if contributor.modified %}~{{ contributor.modified | formatNumber }}{% else %}0{% endif %}
              </td>
              <td class="line-deleted">
                {% if contributor.deleted %}-{{ contributor.deleted | formatNumber }}{% else %}0{% endif %}
              </td>
              <td>
                {{
                  (
                    contributor.added +
                    contributor.modified +
                    contributor.deleted
                  ) | formatNumber
                }}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="5" class="contribution-empty">暂无贡献记录</td>
            </tr>
          {% endfor %}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">全部贡献合计</th>
            <td class="line-added" data-contribution-total="added">
              {% if overallStats.lineTotals.added %}+{{ overallStats.lineTotals.added | formatNumber }}{% else %}0{% endif %}
            </td>
            <td class="line-modified" data-contribution-total="modified">
              {% if overallStats.lineTotals.modified %}~{{ overallStats.lineTotals.modified | formatNumber }}{% else %}0{% endif %}
            </td>
            <td class="line-deleted" data-contribution-total="deleted">
              {% if overallStats.lineTotals.deleted %}-{{ overallStats.lineTotals.deleted | formatNumber }}{% else %}0{% endif %}
            </td>
            <td data-contribution-total="all">
              {{
                (
                  overallStats.lineTotals.added +
                  overallStats.lineTotals.modified +
                  overallStats.lineTotals.deleted
                ) | formatNumber
              }}
            </td>
          </tr>
        </tfoot>
      </table>
    </div>
    <nav class="contribution-pagination" aria-label="贡献者分页">
      <button
        class="icon-button"
        type="button"
        data-contribution-page-previous
        aria-label="上一页"
        title="上一页"
      >
        <i data-lucide="arrow-left" aria-hidden="true"></i>
      </button>
      <span data-contribution-page-status aria-live="polite">
        第 1 / 1 页
      </span>
      <button
        class="icon-button"
        type="button"
        data-contribution-page-next
        aria-label="下一页"
        title="下一页"
      >
        <i data-lucide="arrow-right" aria-hidden="true"></i>
      </button>
    </nav>
  </div>
</section>

<script>
  window.GCK_CONTRIBUTION_STATS = {{ catalog.contentStatistics | json | safe }};
  window.GCK_HOME_STAR_GRAPH = {{ catalog.homeStarGraph | json | safe }};
</script>

<section class="catalog-overview" aria-labelledby="catalog-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Content graph</p>
      <h2 id="catalog-title">知识库目录</h2>
    </div>
    <div class="catalog-stats" aria-label="内容统计">
      <span>按目录自动生成</span>
      <span>持续同步内容仓库</span>
    </div>
  </div>

  {% if catalog.tracks.length %}
    <div class="track-overview-grid">
      {% for track in catalog.tracks %}
        <a class="track-overview-card track-{{ track.key }}" href="{{ track.route | withBase }}">
          <span class="module-icon">
            <i data-lucide="{{ track.icon }}" aria-hidden="true"></i>
          </span>
          <span class="unit-meta">
            {{ track.modules.length }} 个模块 · {{ track.documentCount }} 篇内容{% if track.codeCount %} · {{ track.codeCount }} 个源码文件{% endif %}
          </span>
          <strong>{{ track.title }}</strong>
          <span class="track-overview-description">{{ track.description }}</span>
          {% if track.statistics %}
            <span class="track-statline">
              {{ track.statistics.characterCount | formatNumber }} 字 ·
              {{ track.statistics.lineCount | formatNumber }} 行 ·
              <span data-contribution-count="{{ track.key }}">
                {{ track.statistics.contributorCount }}
              </span>
              位贡献者
            </span>
          {% endif %}
          <i data-lucide="arrow-up-right" aria-hidden="true"></i>
        </a>
      {% endfor %}
    </div>
  {% else %}
    {% for module in catalog.modules %}
    <section class="module-band module-{{ module.accent }}" aria-labelledby="module-{{ module.key }}">
      <div class="module-band-heading">
        <div class="module-identity">
          <span class="module-icon">
            <i data-lucide="{{ module.icon }}" aria-hidden="true"></i>
          </span>
          <div>
            <h3 id="module-{{ module.key }}">{{ module.title }}</h3>
            <p>{{ module.description }}</p>
          </div>
        </div>
        <a class="text-link" href="{{ module.route | withBase }}">
          查看全部
          <i data-lucide="arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="unit-grid">
        {% for unit in module.rootUnits %}
          <a class="unit-card" href="{{ unit.route | withBase }}">
            <span class="unit-meta">
              {{ unit.articleCount }} 篇
              {% if unit.children.length %} · {{ unit.children.length }} 个子专题{% endif %}
              {% if unit.codeCount %} · {{ unit.codeCount }} 个源码文件{% endif %}
            </span>
            <strong>{{ unit.title }}</strong>
            <span class="unit-card-description">{{ unit.description }}</span>
            {% if unit.children.length %}
              <div class="unit-card-children">
                <small>子专题</small>
                {% for child in unit.children %}
                  <span>{{ child.title }}</span>
                {% endfor %}
              </div>
            {% endif %}
            <i data-lucide="arrow-up-right" aria-hidden="true"></i>
          </a>
        {% else %}
          <p class="empty-state">该模块暂无内容。</p>
        {% endfor %}
      </div>
    </section>
    {% endfor %}
  {% endif %}
</section>

<section class="contribution-band">
  <div>
    <p class="eyebrow">目录驱动</p>
    <h2>新增内容，不改网站代码</h2>
    <p>在内容仓库添加文件夹和 Markdown，导航、页面与搜索索引会在下次构建时自动更新。</p>
  </div>
  <div class="contribution-actions">
    <a class="primary-button" href="{{ site.joinUrl }}">
      <i data-lucide="user-plus" aria-hidden="true"></i>
      加入共建
    </a>
    <a class="secondary-button" href="{{ '/contribute/' | withBase }}">
      <i data-lucide="notebook-tabs" aria-hidden="true"></i>
      更新规范
    </a>
  </div>
</section>

<button
  class="home-content-toggle"
  type="button"
  data-home-content-toggle
  aria-label="隐藏主页内容"
  aria-pressed="false"
  title="隐藏主页内容"
>
  <i data-lucide="eye-off" data-home-content-icon="hide" aria-hidden="true"></i>
  <i data-lucide="eye" data-home-content-icon="show" aria-hidden="true"></i>
</button>
