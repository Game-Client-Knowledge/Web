<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#1f2926">
    <meta
      name="description"
      content="{{ description or site.description }}"
    >
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | assetUrl }}">
    {% if pageKind == "document" or pageKind == "module" %}
      <link rel="stylesheet" href="{{ '/assets/vendor/toastui-editor.css' | assetUrl }}">
    {% endif %}
    <link rel="icon" href="{{ '/assets/images/favicon.svg' | assetUrl }}" type="image/svg+xml">
    <script>
      (function () {
        var editorApi = {{ (site.editorUrl ~ 'api') | json | safe }};
        var staticSource = {% if document %}{{ document.sourceRelative | json | safe }}{% elif module %}{{ module.sourceRelative | json | safe }}{% else %}""{% endif %};
        var draftPath = new URLSearchParams(window.location.search).get("draft");
        var sourcePath = draftPath || staticSource;
        var query = sourcePath
          ? "?path=" + encodeURIComponent(sourcePath)
          : "";
        window.GCK_EDITOR_BOOTSTRAP = fetch(
          editorApi + "/bootstrap" + query,
          { credentials: "same-origin" }
        ).then(function (response) {
          if (!response.ok) {
            throw new Error("编辑状态加载失败");
          }
          return response.json();
        }).catch(function (error) {
          return { bootstrap_error: error.message };
        });
      })();
    </script>
  </head>
  <body class="page-{{ pageKind or 'default' }}" data-editor-state="loading">
    <a class="skip-link" href="#main-content">跳到正文</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="{{ '/' | withBase }}" aria-label="Game Client Knowledge 首页">
          <span class="brand-mark" aria-hidden="true">G</span>
          <span class="brand-copy">
            <strong>Game Client</strong>
            <span>Knowledge</span>
          </span>
        </a>

        <nav class="primary-nav" aria-label="主导航">
          {% for module in catalog.modules %}
            <a
              href="{{ module.route | withBase }}"
              {% if activeModule == module.key %}aria-current="page"{% endif %}
            >
              {{ module.shortTitle }}
            </a>
          {% endfor %}
          <a href="{{ site.editorUrl }}">在线编辑</a>
          <a
            href="{{ '/contribute/' | withBase }}"
            {% if pageKind == "contribute" %}aria-current="page"{% endif %}
          >
            更新规范
          </a>
          <a class="join-nav-link" href="{{ site.joinUrl }}">加入共建</a>
        </nav>

        <div class="header-actions">
          <button
            class="search-trigger"
            type="button"
            data-open-search
            aria-label="搜索知识库"
          >
            <i data-lucide="search" aria-hidden="true"></i>
            <span>搜索</span>
            <kbd>⌘ K</kbd>
          </button>
          <a
            class="icon-button"
            href="{{ site.repositoryUrl }}"
            aria-label="打开内容仓库"
            title="内容仓库"
            rel="noreferrer"
          >
            <i data-lucide="github" aria-hidden="true"></i>
          </a>
          <button
            class="edit-mode-trigger"
            type="button"
            data-edit-mode-trigger
            aria-label="进入编辑模式"
            title="编辑模式"
            disabled
          >
            <i data-lucide="square-pen" aria-hidden="true"></i>
            <span data-edit-mode-label>编辑</span>
          </button>
          <button
            class="account-trigger"
            type="button"
            data-account-trigger
            aria-label="登录或打开个人设置"
            title="个人设置"
            aria-busy="true"
            disabled
          >
            <i data-lucide="circle-user-round" aria-hidden="true"></i>
            <span data-account-label>同步中</span>
          </button>
          <button
            class="icon-button mobile-menu-trigger"
            type="button"
            data-toggle-menu
            aria-label="打开导航"
            aria-expanded="false"
            title="导航"
          >
            <i data-lucide="menu" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <nav class="mobile-nav" data-mobile-nav aria-label="移动端导航">
        {% for module in catalog.modules %}
          <a href="{{ module.route | withBase }}">
            <i data-lucide="{{ module.icon }}" aria-hidden="true"></i>
            {{ module.title }}
          </a>
        {% endfor %}
        <a href="{{ site.editorUrl }}">
          <i data-lucide="square-pen" aria-hidden="true"></i>
          在线编辑
        </a>
        <a href="{{ '/contribute/' | withBase }}">
          <i data-lucide="notebook-tabs" aria-hidden="true"></i>
          更新规范
        </a>
        <a href="{{ site.joinUrl }}">
          <i data-lucide="user-plus" aria-hidden="true"></i>
          加入共建
        </a>
      </nav>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div>
        <strong>{{ site.name }}</strong>
        <span>内容与展示分离，目录即导航。</span>
      </div>
      <div class="footer-meta">
        <span>内容版本 {{ catalog.repository.commit }}</span>
        <span>{{ catalog.repository.updatedAt | formatDate }} 更新</span>
      </div>
    </footer>

    <dialog class="search-dialog" data-search-dialog>
      <div class="search-panel">
        <div class="search-input-wrap">
          <i data-lucide="search" aria-hidden="true"></i>
          <input
            type="search"
            placeholder="搜索知识点、面试题或代码"
            autocomplete="off"
            aria-label="搜索知识库"
            data-search-input
          >
          <button
            class="icon-button"
            type="button"
            data-close-search
            aria-label="关闭搜索"
            title="关闭"
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </div>
        <p class="search-status" data-search-status>输入关键词开始搜索</p>
        <div class="search-results" data-search-results></div>
      </div>
    </dialog>

    <dialog class="account-dialog" data-account-dialog>
      <div class="account-panel">
        <header class="account-panel-header">
          <div>
            <p class="eyebrow">Account</p>
            <h2 data-account-title>登录与个人设置</h2>
          </div>
          <button
            class="icon-button"
            type="button"
            data-close-account
            aria-label="关闭个人设置"
            title="关闭"
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </header>

        <section data-account-guest>
          <div class="account-tabs" role="tablist" aria-label="账号操作">
            <button class="is-active" type="button" data-account-tab="login">登录</button>
            <button type="button" data-account-tab="register">注册</button>
          </div>
          <form class="account-form" data-account-login-form>
            <label>
              邮箱或用户名
              <input name="identifier" autocomplete="username" required maxlength="254">
            </label>
            <label>
              密码
              <input name="password" type="password" autocomplete="current-password" required maxlength="256">
            </label>
            <button class="primary-button" type="submit">登录</button>
          </form>
          <form class="account-form" data-account-register-form hidden>
            <label>
              邮箱
              <input name="email" type="email" autocomplete="email" required maxlength="254">
            </label>
            <label>
              用户名
              <input name="username" autocomplete="username" required maxlength="32">
            </label>
            <label>
              密码
              <input name="password" type="password" autocomplete="new-password" minlength="8" required maxlength="256">
            </label>
            <button class="primary-button" type="submit">创建账号</button>
          </form>
          <div class="account-divider"><span>或</span></div>
          <a class="github-login-button" data-account-github-login href="{{ site.editorUrl }}api/auth/github">
            <i data-lucide="github" aria-hidden="true"></i>
            使用 GitHub 登录
          </a>
          <p class="account-policy" data-account-policy></p>
        </section>

        <section class="account-profile" data-account-user hidden>
          <div class="account-identity">
            <span class="account-avatar" data-account-avatar>U</span>
            <div>
              <strong data-account-username></strong>
              <span data-account-email></span>
            </div>
          </div>
          <dl class="account-status-list">
            <div>
              <dt>GitHub</dt>
              <dd data-account-github-status>未绑定</dd>
            </div>
            <div>
              <dt>草稿</dt>
              <dd data-account-draft-count>0 个</dd>
            </div>
          </dl>
          <div class="account-actions">
            <a class="secondary-button" href="{{ site.editorUrl }}">
              <i data-lucide="folder-tree" aria-hidden="true"></i>
              打开编辑工作台
            </a>
            <a class="secondary-button" data-account-bind-github href="{{ site.editorUrl }}api/auth/github?mode=bind">
              <i data-lucide="github" aria-hidden="true"></i>
              绑定 GitHub
            </a>
            <button class="secondary-button" type="button" data-account-unlink-github hidden>
              <i data-lucide="unlink" aria-hidden="true"></i>
              解绑 GitHub
            </button>
            <a class="secondary-button" data-account-admin href="{{ site.editorUrl }}admin" hidden>
              <i data-lucide="shield-check" aria-hidden="true"></i>
              管理后台
            </a>
            <button class="quiet-command" type="button" data-account-logout>退出登录</button>
          </div>
        </section>
        <div class="account-feedback" data-account-feedback role="status" aria-live="polite"></div>
      </div>
    </dialog>

    <dialog class="content-create-dialog" data-content-create-dialog>
      <form class="content-create-form" data-content-create-form>
        <header>
          <div>
            <p class="eyebrow">Create content</p>
            <h2 data-create-dialog-title>新建内容</h2>
            <p data-create-location></p>
          </div>
          <button
            class="icon-button"
            type="button"
            data-close-content-create
            aria-label="关闭"
            title="关闭"
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </header>
        <input name="root" type="hidden">
        <input name="parent" type="hidden">
        <input name="kind" type="hidden">
        <label>
          目录或文件名
          <input name="slug" placeholder="polymorphism" required maxlength="80">
        </label>
        <label>
          展示标题
          <input name="title" placeholder="C++ 多态" required maxlength="120">
        </label>
        <label data-create-description-field>
          简介
          <textarea name="description" rows="3" maxlength="500"></textarea>
        </label>
        <footer>
          <button class="secondary-button" type="button" data-close-content-create>取消</button>
          <button class="primary-button" type="submit">创建草稿</button>
        </footer>
        <div class="account-feedback" data-create-feedback role="status" aria-live="polite"></div>
      </form>
    </dialog>

    <script>
      window.GCK_CONFIG = {
        basePath: {{ site.basePath | json | safe }},
        searchIndex: {{ (('/search-index.json' | withBase) + '?v=' + site.searchVersion) | json | safe }},
        editorUrl: {{ site.editorUrl | json | safe }},
        editorApi: {{ (site.editorUrl ~ 'api') | json | safe }},
        editorContext: {
          pageKind: {{ (pageKind or "default") | json | safe }},
          sourcePath: {% if document %}{{ document.sourceRelative | json | safe }}{% elif module %}{{ module.sourceRelative | json | safe }}{% else %}null{% endif %},
          sourceDirectory: {% if document %}{{ document.sourceDirectory | json | safe }}{% elif module %}{{ module.key | json | safe }}{% else %}null{% endif %},
          root: {% if document %}{{ document.moduleKey | json | safe }}{% elif module %}{{ module.key | json | safe }}{% else %}null{% endif %}
        }
      };
    </script>
    <script src="{{ '/assets/vendor/lucide.js' | assetUrl }}"></script>
    {% if pageKind == "document" or pageKind == "module" %}
      <script src="{{ '/assets/vendor/toastui-editor.js' | assetUrl }}"></script>
      <script src="{{ '/assets/vendor/diff.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/markdown-preserve.js' | assetUrl }}"></script>
    {% endif %}
    {% if
      (document and document.hasMermaid)
      or (module and module.hasMermaid)
      or (pageKind == "contribute" and catalog.contribution.hasMermaid)
    %}
      <script src="{{ '/assets/vendor/mermaid.min.js' | assetUrl }}"></script>
    {% endif %}
    <script src="{{ '/assets/js/site.js' | assetUrl }}"></script>
    <script src="{{ '/assets/js/search.js' | assetUrl }}"></script>
    <script src="{{ '/assets/js/editor-integration.js' | assetUrl }}"></script>
  </body>
</html>
