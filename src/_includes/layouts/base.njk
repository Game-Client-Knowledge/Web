{% set pageHasMermaid =
  (document and document.hasMermaid)
  or (module and module.hasMermaid)
  or (pageKind == "contribute" and catalog.contribution.hasMermaid)
%}
<!doctype html>
<html lang="zh-CN"{% if pageHasMermaid %} class="mermaid-loading"{% endif %}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <meta name="theme-color" content="#1f2926">
    <meta
      name="description"
      content="{{ description or site.description }}"
    >
    <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
    {% if pageKind == "home" %}
      <link
        rel="preload"
        href="{{ '/assets/js/site-visuals.js' | assetUrl }}"
        as="script"
      >
      <style>
        .site-entry-sequence {
          position: relative;
          display: block;
          width: 100%;
          min-height: 100vh;
          min-height: 100svh;
          background: #0b1512;
          overflow: hidden;
        }
        .site-entry-sequence canvas {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
        }
        .home-intro-seen .site-entry-sequence {
          display: none;
        }
      </style>
    {% endif %}
    {% if pageHasMermaid %}
      <link
        rel="modulepreload"
        href="{{ '/assets/vendor/mermaid/mermaid-client.js' | assetUrl }}"
      >
    {% endif %}
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | assetUrl }}">
    {% if pageKind == "code-workspace" or activeModule == "code" %}
      <link rel="stylesheet" href="{{ '/assets/css/code-reader.css' | assetUrl }}">
    {% endif %}
    {% if pageKind == "document" or pageKind == "module" %}
      <link rel="stylesheet" href="{{ '/assets/vendor/toastui-editor.css' | assetUrl }}">
    {% endif %}
    <link rel="icon" href="{{ '/assets/images/favicon.svg' | assetUrl }}" type="image/svg+xml">
    <script src="{{ '/assets/js/source-cache.js' | assetUrl }}"></script>
    <script>
      window.GCK_PAGE_KIND = {{ (pageKind or "default") | json | safe }};
    </script>
    <script src="{{ '/assets/js/home-intro-policy.js' | assetUrl }}"></script>
    <script>
      (function () {
        var editorApi = {{ (site.editorUrl ~ 'api') | json | safe }};
        var staticSource = {% if document %}{{ document.sourceRelative | json | safe }}{% elif module %}{{ module.sourceRelative | json | safe }}{% else %}""{% endif %};
        var contentVersion = {{ catalog.repository.commit | json | safe }};
        var rawBase = {{ '/raw/' | withBase | json | safe }};
        var draftPath = new URLSearchParams(window.location.search).get("draft");
        var sourcePath = draftPath || staticSource;
        var query = sourcePath
          ? "?path=" + encodeURIComponent(sourcePath)
          : "";
        window.GCK_SOURCE_PREFETCH =
          staticSource && window.GCKSource
            ? {
                path: staticSource,
                version: contentVersion,
                promise: window.GCKSource.load(staticSource, {
                  version: contentVersion,
                  rawBase: rawBase
                }).catch(function () {
                  return null;
                })
              }
            : null;
        window.GCK_EDITOR_BOOTSTRAP_PATH = "/bootstrap" + query;
        window.GCK_EDITOR_BOOTSTRAP = null;
      })();
    </script>
  </head>
  <body class="page-{{ pageKind or 'default' }}" data-editor-state="ready">
    {% if pageKind == "home" %}
      <section
        class="site-entry-sequence"
        data-entry-sequence
        aria-hidden="true"
      >
        <canvas data-entry-canvas></canvas>
        <span class="site-entry-progress" data-entry-progress></span>
        <span class="site-entry-scroll-cue"></span>
      </section>
    {% endif %}
    <a class="skip-link" href="#main-content">跳到正文</a>

    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="{{ '/' | withBase }}" aria-label="Game Client Knowledge 首页">
          <span class="brand-mark" aria-hidden="true">G</span>
          <span class="brand-copy">
            <strong>Game Client</strong>
            <span>Knowledge</span>
          </span>
        </a>

        <nav class="primary-nav" aria-label="主导航">
          {% if catalog.tracks.length and activeTrack %}
            {% for module in catalog.modules %}
              {% if module.trackKey == activeTrack %}
                <a
                  href="{{ module.route | withBase }}"
                  {% if activeModule == module.key %}aria-current="page"{% endif %}
                >
                  {{ module.shortTitle }}
                </a>
              {% endif %}
            {% endfor %}
          {% elif catalog.tracks.length %}
            {% for track in catalog.tracks %}
              <a
                href="{{ track.route | withBase }}"
                {% if activeTrack == track.key %}aria-current="page"{% endif %}
              >
                {{ track.shortTitle }}
              </a>
            {% endfor %}
          {% else %}
          {% for module in catalog.modules %}
            <a
              href="{{ module.route | withBase }}"
              {% if activeModule == module.key %}aria-current="page"{% endif %}
            >
              {{ module.shortTitle }}
            </a>
          {% endfor %}
          {% endif %}
        </nav>

        <div class="header-actions">
          <button
            class="search-trigger"
            type="button"
            data-open-search
            aria-label="搜索知识库"
          >
            <i data-lucide="search" aria-hidden="true"></i>
            <span>搜索</span>
            <kbd>⌘ K</kbd>
          </button>
          <nav class="utility-nav" aria-label="快捷入口">
            <a
              href="{{ site.editorUrl }}"
              data-change-overview-link
              hidden
            >
              <i data-lucide="list-tree" aria-hidden="true"></i>
              <span>更改总览</span>
            </a>
            <a
              href="{{ '/contribute/' | withBase }}"
              {% if pageKind == "contribute" %}aria-current="page"{% endif %}
            >
              <i data-lucide="notebook-tabs" aria-hidden="true"></i>
              <span>更新规范</span>
            </a>
            <a href="{{ site.joinUrl }}">
              <i data-lucide="user-plus" aria-hidden="true"></i>
              <span>加入共建</span>
            </a>
          </nav>
          <a
            class="icon-button repository-link"
            href="{{ site.repositoryUrl }}"
            aria-label="打开内容仓库"
            title="内容仓库"
            rel="noreferrer"
          >
            <i data-lucide="github" aria-hidden="true"></i>
          </a>
          <button
            class="edit-mode-trigger"
            type="button"
            data-edit-mode-trigger
            aria-label="进入编辑模式"
            title="编辑模式"
            disabled
          >
            <i data-lucide="square-pen" aria-hidden="true"></i>
            <span data-edit-mode-label>编辑</span>
          </button>
          <button
            class="account-trigger"
            type="button"
            data-account-trigger
            aria-label="登录或打开个人设置"
            title="个人设置"
            disabled
          >
            <i data-lucide="circle-user-round" aria-hidden="true"></i>
            <span data-account-label>登录</span>
          </button>
          <button
            class="icon-button mobile-menu-trigger"
            type="button"
            data-toggle-menu
            aria-label="打开导航"
            aria-expanded="false"
            title="导航"
          >
            <i data-lucide="menu" aria-hidden="true"></i>
          </button>
        </div>
      </div>

      <nav class="mobile-nav" data-mobile-nav aria-label="移动端导航">
        {% if catalog.tracks.length and activeTrack %}
          {% for module in catalog.modules %}
            {% if module.trackKey == activeTrack %}
              <a href="{{ module.route | withBase }}">
                <i data-lucide="{{ module.icon }}" aria-hidden="true"></i>
                {{ module.title }}
              </a>
            {% endif %}
          {% endfor %}
        {% elif catalog.tracks.length %}
          {% for track in catalog.tracks %}
            <a href="{{ track.route | withBase }}">
              <i data-lucide="{{ track.icon }}" aria-hidden="true"></i>
              {{ track.title }}
            </a>
          {% endfor %}
        {% else %}
        {% for module in catalog.modules %}
          <a href="{{ module.route | withBase }}">
            <i data-lucide="{{ module.icon }}" aria-hidden="true"></i>
            {{ module.title }}
          </a>
        {% endfor %}
        {% endif %}
      </nav>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div>
        <strong>{{ site.name }}</strong>
        <span>内容与展示分离，目录即导航。</span>
      </div>
      <div class="footer-meta">
        <span>内容版本 {{ catalog.repository.commit }}</span>
        <span>{{ catalog.repository.updatedAt | formatDate }} 更新</span>
      </div>
    </footer>

    <dialog class="search-dialog" data-search-dialog>
      <div class="search-panel">
        <div class="search-input-wrap">
          <i data-lucide="search" aria-hidden="true"></i>
          <input
            type="search"
            placeholder="搜索知识点、面试题或代码"
            autocomplete="off"
            aria-label="搜索知识库"
            data-search-input
          >
          <button
            class="icon-button"
            type="button"
            data-close-search
            aria-label="关闭搜索"
            title="关闭"
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </div>
        <p class="search-status" data-search-status>输入关键词开始搜索</p>
        <div class="search-results" data-search-results></div>
      </div>
    </dialog>

    <dialog class="account-dialog" data-account-dialog>
      <div class="account-panel">
        <header class="account-panel-header">
          <div>
            <p class="eyebrow">Account</p>
            <h2 data-account-title>登录与个人设置</h2>
          </div>
          <button
            class="icon-button"
            type="button"
            data-close-account
            aria-label="关闭个人设置"
            title="关闭"
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </header>

        <section data-account-guest>
          <div class="account-tabs" role="tablist" aria-label="账号操作">
            <button class="is-active" type="button" data-account-tab="login">登录</button>
            <button type="button" data-account-tab="register">注册</button>
          </div>
          <form class="account-form" data-account-login-form>
            <label>
              邮箱或用户名
              <input name="identifier" autocomplete="username" required maxlength="254">
            </label>
            <label>
              密码
              <input name="password" type="password" autocomplete="current-password" required maxlength="256">
            </label>
            <button class="primary-button" type="submit">登录</button>
          </form>
          <form class="account-form" data-account-register-form hidden>
            <label>
              邮箱
              <input name="email" type="email" autocomplete="email" required maxlength="254">
            </label>
            <label>
              用户名
              <input name="username" autocomplete="username" required maxlength="32">
            </label>
            <label>
              密码
              <input name="password" type="password" autocomplete="new-password" minlength="8" required maxlength="256">
            </label>
            <button class="primary-button" type="submit">创建账号</button>
          </form>
          <div class="account-divider"><span>或</span></div>
          <a class="github-login-button" data-account-github-login href="{{ site.editorUrl }}api/auth/github">
            <i data-lucide="github" aria-hidden="true"></i>
            使用 GitHub 登录
          </a>
          <p class="github-prerequisite">
            建议先在当前浏览器
            <a href="https://github.com/login" target="_blank" rel="noreferrer">登录 GitHub</a>，
            再返回完成授权。
          </p>
          <p class="account-policy" data-account-policy></p>
        </section>

        <section class="account-profile" data-account-user hidden>
          <div class="account-identity">
            <span class="account-avatar" data-account-avatar>U</span>
            <div>
              <strong data-account-username></strong>
              <span data-account-email></span>
            </div>
          </div>
          <dl class="account-status-list">
            <div>
              <dt>GitHub</dt>
              <dd data-account-github-status>未绑定</dd>
            </div>
            <div>
              <dt>草稿</dt>
              <dd data-account-draft-count>0 个</dd>
            </div>
          </dl>
          <div class="account-actions">
            <a class="secondary-button" href="{{ site.editorUrl }}">
              <i data-lucide="folder-tree" aria-hidden="true"></i>
              打开编辑工作台
            </a>
            <a class="secondary-button" data-account-bind-github href="{{ site.editorUrl }}api/auth/github?mode=bind">
              <i data-lucide="github" aria-hidden="true"></i>
              绑定 GitHub
            </a>
            <button class="secondary-button" type="button" data-account-unlink-github hidden>
              <i data-lucide="unlink" aria-hidden="true"></i>
              解绑 GitHub
            </button>
            <a class="secondary-button" data-account-admin href="{{ site.editorUrl }}admin" hidden>
              <i data-lucide="shield-check" aria-hidden="true"></i>
              管理后台
            </a>
            <button class="quiet-command" type="button" data-account-logout>退出登录</button>
          </div>
          <p class="github-prerequisite">
            绑定前建议先在当前浏览器
            <a href="https://github.com/login" target="_blank" rel="noreferrer">登录 GitHub</a>，
            再点击绑定。
          </p>
        </section>
        <div class="account-feedback" data-account-feedback role="status" aria-live="polite"></div>
      </div>
    </dialog>

    <dialog
      class="onboarding-dialog"
      data-onboarding-dialog
      aria-labelledby="onboarding-title"
    >
      <section class="onboarding-panel">
        <header class="onboarding-header">
          <div>
            <p class="eyebrow">First login guide</p>
            <h2 id="onboarding-title">开始参与知识库共建</h2>
          </div>
          <span data-onboarding-counter>1 / 4</span>
        </header>
        <div class="onboarding-progress" aria-hidden="true">
          <span data-onboarding-progress></span>
          <span data-onboarding-progress></span>
          <span data-onboarding-progress></span>
          <span data-onboarding-progress></span>
        </div>
        <div class="onboarding-steps">
          <article data-onboarding-step>
            <span class="onboarding-icon">
              <i data-lucide="notebook-tabs" aria-hidden="true"></i>
            </span>
            <div>
              <p class="eyebrow">01 · 先读规范</p>
              <h3>目录结构决定导航结构</h3>
              <p>
                提交前请确认文件位置、Markdown 标题、命名和内容范围。
                规范页面包含知识、面经与代码示例的完整约定。
              </p>
              <a href="{{ '/contribute/' | withBase }}" target="_blank">
                打开建设规范
                <i data-lucide="arrow-up-right" aria-hidden="true"></i>
              </a>
            </div>
          </article>
          <article data-onboarding-step hidden>
            <span class="onboarding-icon is-orange">
              <i data-lucide="user-plus" aria-hidden="true"></i>
            </span>
            <div>
              <p class="eyebrow">02 · 加入组织</p>
              <h3>申请后还要接受 GitHub 邀请</h3>
              <p>
                加入页会自动创建组织邀请。收到 GitHub 邮件或通知后，
                仍需手动接受，账号才会成为组织成员。
              </p>
              <a href="{{ site.joinUrl }}" target="_blank" rel="noreferrer">
                前往加入页面
                <i data-lucide="arrow-up-right" aria-hidden="true"></i>
              </a>
            </div>
          </article>
          <article data-onboarding-step hidden>
            <span class="onboarding-icon is-gold">
              <i data-lucide="square-pen" aria-hidden="true"></i>
            </span>
            <div>
              <p class="eyebrow">03 · 页面内编辑</p>
              <h3>使用右上角“编辑”进入或退出编辑模式</h3>
              <p>
                进入后可直接修改当前文档，也可在模块中创建子模块和文件。
                保存只会写入你的个人草稿，不会直接修改 main。
              </p>
            </div>
          </article>
          <article data-onboarding-step hidden>
            <span class="onboarding-icon">
              <i data-lucide="git-pull-request-arrow" aria-hidden="true"></i>
            </span>
            <div>
              <p class="eyebrow">04 · 统一提交</p>
              <h3>在工作台检查更改并创建 Draft PR</h3>
              <p>
                工作台会用 A/M/D 标记全部草稿。填写提交头和说明后，
                系统创建个人分支、一个 commit 和一份 Draft Pull Request。
              </p>
              <a href="{{ site.editorUrl }}" target="_blank">
                打开编辑工作台
                <i data-lucide="arrow-up-right" aria-hidden="true"></i>
              </a>
            </div>
          </article>
        </div>
        <footer class="onboarding-footer">
          <button class="quiet-command" type="button" data-onboarding-skip>
            跳过引导
          </button>
          <div>
            <button
              class="secondary-button"
              type="button"
              data-onboarding-previous
              hidden
            >
              上一步
            </button>
            <button class="primary-button" type="button" data-onboarding-next>
              下一步
            </button>
            <button
              class="primary-button"
              type="button"
              data-onboarding-finish
              hidden
            >
              完成引导
            </button>
          </div>
        </footer>
        <div
          class="account-feedback"
          data-onboarding-feedback
          role="status"
          aria-live="polite"
        ></div>
      </section>
    </dialog>

    <dialog class="content-create-dialog" data-content-create-dialog>
      <form class="content-create-form" data-content-create-form>
        <header>
          <div>
            <p class="eyebrow">Create content</p>
            <h2 data-create-dialog-title>新建内容</h2>
            <p data-create-location></p>
          </div>
          <button
            class="icon-button"
            type="button"
            data-close-content-create
            aria-label="关闭"
            title="关闭"
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </header>
        <input name="root" type="hidden">
        <input name="parent" type="hidden">
        <input name="kind" type="hidden">
        <label>
          目录或文件名
          <input name="slug" placeholder="polymorphism" required maxlength="80">
        </label>
        <label>
          展示标题
          <input name="title" placeholder="C++ 多态" required maxlength="120">
        </label>
        <label data-create-description-field>
          简介
          <textarea name="description" rows="3" maxlength="500"></textarea>
        </label>
        <footer>
          <button class="secondary-button" type="button" data-close-content-create>取消</button>
          <button class="primary-button" type="submit">创建草稿</button>
        </footer>
        <div class="account-feedback" data-create-feedback role="status" aria-live="polite"></div>
      </form>
    </dialog>

    <script>
      window.GCK_CONFIG = {
        basePath: {{ site.basePath | json | safe }},
        searchIndex: {{ (('/search-index.json' | withBase) + '?v=' + site.searchVersion) | json | safe }},
        editorUrl: {{ site.editorUrl | json | safe }},
        editorApi: {{ (site.editorUrl ~ 'api') | json | safe }},
        assetVersion: {{ site.assetVersion | json | safe }},
        contentVersion: {{ catalog.repository.commit | json | safe }},
        repository: {{ catalog.repositoryUrl | json | safe }},
        rawBase: {{ '/raw/' | withBase | json | safe }},
        contentRoutes: {{ catalog.sourceRoutes | json | safe }},
        workspaceEntries: {{ catalog.workspaceEntries | json | safe }},
        contributors: {{ catalog.contributors | json | safe }},
        editorContext: {
          pageKind: {{ (pageKind or "default") | json | safe }},
          sourcePath: {% if document %}{{ document.sourceRelative | json | safe }}{% elif module %}{{ module.sourceRelative | json | safe }}{% else %}null{% endif %},
          sourceDirectory: {% if document %}{{ document.sourceDirectory | json | safe }}{% elif module %}{{ module.key | json | safe }}{% else %}null{% endif %},
          root: {% if document %}{{ document.moduleKey | json | safe }}{% elif module %}{{ module.key | json | safe }}{% else %}null{% endif %}
        }
      };
      window.GCK_VISUAL_SETTINGS = Promise.resolve().then(function () {
        var settings = {};
        try {
          var identity = JSON.parse(
            window.localStorage.getItem("gck-editor-identity:v1") || "null"
          );
          if (identity && identity.payload && identity.payload.config) {
            settings = Object.assign(settings, identity.payload.config);
          }
          var intro = JSON.parse(
            window.localStorage.getItem("gck-home-intro-settings") || "null"
          );
          if (intro) {
            settings = Object.assign(settings, intro);
          }
        } catch (error) {
          settings = {};
        }
        return settings;
      });
    </script>
    <script src="{{ '/assets/js/site-visuals.js' | assetUrl }}"></script>
    <script src="{{ '/assets/vendor/lucide.js' | assetUrl }}"></script>
    {% if pageKind == "document" or pageKind == "module" %}
      <script src="{{ '/assets/vendor/toastui-editor.js' | assetUrl }}"></script>
      <script src="{{ '/assets/vendor/diff.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/markdown-preserve.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/editor-buffer.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/workspace-store.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/workspace-tree.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/reader-diff.js' | assetUrl }}"></script>
    {% endif %}
    {% if pageHasMermaid %}
      <script
        type="module"
        src="{{ '/assets/vendor/mermaid/mermaid-client.js' | assetUrl }}"
      ></script>
    {% endif %}
    {% if pageKind == "code-workspace" %}
      <script src="{{ '/assets/vendor/code-reader-vendor.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/code-reader.js' | assetUrl }}"></script>
    {% endif %}
    {% if pageKind == "home" %}
      <script src="{{ '/assets/js/home-star-illumination.js' | assetUrl }}"></script>
      <script src="{{ '/assets/js/home-star-map.js' | assetUrl }}"></script>
    {% endif %}
    <script src="{{ '/assets/js/site.js' | assetUrl }}"></script>
    <script src="{{ '/assets/js/search.js' | assetUrl }}"></script>
    {% if pageKind == "home" %}
      <script src="{{ '/assets/js/home-statistics.js' | assetUrl }}"></script>
    {% endif %}
    <script src="{{ '/assets/js/editor-integration.js' | assetUrl }}"></script>
  </body>
</html>
