[Unit]
Description=Publish pushed Game Client Knowledge Web and content commits
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sourcecode
Group=sourcecode
WorkingDirectory=/home/sourcecode/gck-builder/web
TimeoutStartSec=15min
Environment=PATH=/home/sourcecode/.local/node-current/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/etc/game-client-knowledge-editor.env
ExecStart=/home/sourcecode/gck-builder/web/deploy/server/update-site.sh

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/sourcecode/gck-builder /var/www/game-client-knowledge /var/lib/game-client-knowledge-editor
