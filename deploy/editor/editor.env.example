EDITOR_DB_PATH=/var/lib/game-client-knowledge-editor/editor.db
EDITOR_BASE_URL=https://knowledge.chenyurui.top/editor
EDITOR_COOKIE_SECURE=true
EDITOR_COOKIE_PATH=/editor
EDITOR_REGISTRATION_ENABLED=true
EDITOR_EDIT_POLICY=local_authenticated
EDITOR_PR_AUTO_CLOSE_DAYS=7
EDITOR_PR_SYNC_INTERVAL_SECONDS=900

# Required only when the database has no users. Remove the password after the
# bootstrap administrator has changed it.
EDITOR_BOOTSTRAP_ADMIN_EMAIL=administrator@example.com
EDITOR_BOOTSTRAP_ADMIN_USERNAME=sourcecode
EDITOR_BOOTSTRAP_ADMIN_PASSWORD=

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EDITOR_ENCRYPTION_KEY=

EDITOR_GITHUB_OWNER=Game-Client-Knowledge
EDITOR_GITHUB_REPOSITORY=Game-Client-Knowledge
EDITOR_GITHUB_CLIENT_ID=
EDITOR_GITHUB_CLIENT_SECRET=
EDITOR_GITHUB_BOT_TOKEN=

# Shared only with the local site update service. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
EDITOR_ATTRIBUTION_SYNC_TOKEN=

EDITOR_SMTP_HOST=
EDITOR_SMTP_PORT=587
EDITOR_SMTP_USERNAME=
EDITOR_SMTP_PASSWORD=
EDITOR_SMTP_FROM=
EDITOR_SMTP_STARTTLS=true
